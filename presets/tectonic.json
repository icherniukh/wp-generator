{
  "preset_id": "tectonic",
  "name": "Tectonic",
  "description": "Deep obsidian and volcanic basalt trenches paired with luminous cyan and ember elevation peaks, finished with vector topographic contour isobars.",
  "color_space": "oklch",
  "color_count": { "type": "uniform_int", "min": 3, "max": 4 },
  "palette_structure": [
    {
      "role": "grounding_anchor",
      "hue": { "type": "uniform", "min": 0.0, "max": 1.0 },
      "lightness": { "type": "gaussian", "mu": 0.16, "sigma": 0.04, "clip": [0.08, 0.24] },
      "chroma": { "type": "gaussian", "mu": 0.35, "sigma": 0.08, "clip": [0.18, 0.55] }
    },
    {
      "role": "accent_core",
      "hue": { "type": "relative", "target": "grounding_anchor", "mu_offset": 140, "sigma": 40 },
      "lightness": { "type": "gaussian", "mu": 0.72, "sigma": 0.08, "clip": [0.55, 0.88] },
      "chroma": { "type": "gaussian", "mu": 0.80, "sigma": 0.10, "clip": [0.60, 0.98] }
    }
  ],
  "overrides": {
    "engine": "topographic",
    "complexity": 5,
    "warp_strength": 0.9,
    "contours": 0.85,
    "contour_levels": 24,
    "contour_width": 1.4,
    "contour_mode": "light",
    "noise": 0.035,
    "vignette": 0.2,
    "dots": 0.0,
    "glass": false
  }
}
