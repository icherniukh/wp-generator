{
  "preset_id": "fractal",
  "name": "Fractal",
  "description": "Volumetric dynamical Julia sets and fluid domain-warped folds unified with ambient lighting and cyclic phase offsets.",
  "color_space": "oklch",
  "color_count": { "type": "uniform_int", "min": 3, "max": 4 },
  "palette_families": [
    ["#03051b", "#7e68d4", "#e377ce", "#ffc1a5"],
    ["#00090f", "#008b96", "#12c281", "#bfdf86"],
    ["#140202", "#c95427", "#e88c00", "#f8ca65"],
    ["#030419", "#4671f0", "#ee47a4", "#00e5f2"],
    ["#140008", "#ca4b78", "#f272a2", "#ffcfa0"],
    ["#000a04", "#278a50", "#20ba71", "#b2e35e"],
    ["#020718", "#5877c5", "#8893e8", "#d6bfea"],
    ["#160105", "#ce4e20", "#ea7a00", "#ffcf48"],
    ["#00080f", "#0a858d", "#00b875", "#a5dc4e"],
    ["#0d0214", "#8c69b8", "#d47ba8", "#f5be8c"],
    ["#01061d", "#3e78de", "#3bb4f2", "#c6e3ff"],
    ["#120704", "#b46635", "#e17b50", "#f8c89b"]
  ],
  "palette_structure": [
    {
      "role": "grounding_anchor",
      "hue": { "type": "uniform", "min": 0.0, "max": 1.0 },
      "lightness": { "type": "gaussian", "mu": 0.14, "sigma": 0.03, "clip": [0.08, 0.20] },
      "chroma": { "type": "gaussian", "mu": 0.20, "sigma": 0.05, "clip": [0.10, 0.35] }
    },
    {
      "role": "accent_core",
      "hue": { "type": "relative", "target": "grounding_anchor", "mu_offset": 135, "sigma": 30 },
      "lightness": { "type": "gaussian", "mu": 0.68, "sigma": 0.06, "clip": [0.55, 0.88] },
      "chroma": { "type": "gaussian", "mu": 0.65, "sigma": 0.08, "clip": [0.45, 0.85] }
    }
  ],
  "overrides": {
    "engine": "fractal",
    "fractal_type": "fluid",
    "complexity": 4,
    "frequency": 1.0,
    "trap_weight": 0.25,
    "phase_offset": 0.0,
    "noise": 0.03,
    "vignette": 0.22,
    "dots": 0.0,
    "glass": false,
    "harmonize": "none"
  }
}
