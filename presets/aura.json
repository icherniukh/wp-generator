{
  "preset_id": "aura",
  "version": "1.0.0",
  "description": "Soft blurred color blobs stacked over a dark base, with visible grain (the blurred-blob packs).",
  "color_space": "oklch",
  "color_count": {
    "type": "uniform_int",
    "min": 3,
    "max": 5
  },
  "palette_structure": [
    {
      "role": "grounding_anchor",
      "hue": {
        "type": "uniform",
        "min": 0,
        "max": 1.0
      },
      "lightness": {
        "type": "gaussian",
        "mu": 0.15,
        "sigma": 0.03,
        "clip": [
          0.08,
          0.24
        ]
      },
      "chroma": {
        "type": "beta",
        "alpha": 2,
        "beta": 6,
        "scale": 0.3
      }
    },
    {
      "role": "accent_core",
      "hue": {
        "type": "uniform",
        "min": 0,
        "max": 1.0
      },
      "lightness": {
        "type": "gaussian",
        "mu": 0.68,
        "sigma": 0.08,
        "clip": [
          0.52,
          0.84
        ]
      },
      "chroma": {
        "type": "gaussian",
        "mu": 0.62,
        "sigma": 0.12,
        "clip": [
          0.4,
          0.85
        ]
      }
    }
  ],
  "overrides": {
    "engine": "blobs",
    "noise": {
      "type": "gaussian",
      "mu": 0.05,
      "sigma": 0.015,
      "clip": [
        0.02,
        0.09
      ]
    }
  }
}
