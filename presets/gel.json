{
  "preset_id": "gel",
  "version": "1.0.0",
  "description": "Glossy 3D glass: soft color blobs lit as a relief, with a highlight that takes the colors underneath.",
  "color_space": "oklch",
  "palette_families": [
    ["#2b1055", "#7f5af0", "#ff6ac1", "#ffb86b", "#6be5ff"],
    ["#0b2447", "#19a7ce", "#7be0d0", "#ffd1a9", "#ff7eb3"],
    ["#3a0f3f", "#e84a9a", "#ff9a62", "#ffe29a", "#8f7cff"],
    ["#07313a", "#22c7a9", "#b6f05b", "#ffd45e", "#4aa8ff"],
    ["#2a1a5e", "#5b8def", "#b79cff", "#ff8ac9", "#ffe1f0"],
    ["#401018", "#ff5d5d", "#ffb347", "#fff0a8", "#c56cf0"]
  ],
  "overrides": {
    "engine": "blobs",
    "shading": 1.0,
    "stage_params": {
      "shading": {
        "tint": 0.8,
        "depth": 1.6,
        "light_elevation": 55,
        "specular": 0.7,
        "shininess": 20,
        "rim": 0.6,
        "smoothing": 50
      }
    },
    "noise": {
      "type": "gaussian",
      "mu": 0.02,
      "sigma": 0.008,
      "clip": [
        0.0,
        0.04
      ]
    },
    "harmonize": "none"
  }
}
