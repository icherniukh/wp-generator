{
  "preset_id": "gel",
  "version": "1.0.0",
  "description": "Glossy 3D glass: soft color blobs lit as a relief, with a highlight that takes the colors underneath.",
  "color_space": "oklch",
  "palette_families": [
    [
      "#5b2bd9",
      "#8f5bff",
      "#ff5fb3",
      "#ffa27a",
      "#5fd8ff"
    ],
    [
      "#0a5fb5",
      "#2fa8ff",
      "#59e3d0",
      "#ffd6a5",
      "#ff8bb0"
    ],
    [
      "#b0245f",
      "#ff5c8a",
      "#ff9a5c",
      "#ffd37a",
      "#9a7bff"
    ],
    [
      "#0b7a6e",
      "#26c9a8",
      "#a6ee6a",
      "#ffe066",
      "#4aa8ff"
    ],
    [
      "#4338ca",
      "#7c6bff",
      "#c58bff",
      "#ff8fd0",
      "#ffd9ec"
    ],
    [
      "#a3281f",
      "#ff6347",
      "#ffb04a",
      "#ffe9a0",
      "#d06cff"
    ]
  ],
  "overrides": {
    "engine": "blobs",
    "shading": 0.9,
    "stage_params": {
      "shading": {
        "tint": 0.5,
        "depth": 2.2,
        "light_elevation": 52,
        "specular": 1.0,
        "shininess": 40,
        "rim": 0.7,
        "smoothing": 40
      },
      "blob-layers": {
        "blobs": 4,
        "blur": 0.4
      }
    },
    "noise": {
      "type": "gaussian",
      "mu": 0.02,
      "sigma": 0.008,
      "clip": [
        0.0,
        0.04
      ]
    },
    "harmonize": "none"
  }
}
