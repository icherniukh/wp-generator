{
  "preset_id": "nocturne",
  "name": "Nocturne",
  "description": "Deep, richly-tinted grounding anchors paired with luminous, high-contrast twilight and ember accents.",
  "color_space": "oklch",
  "color_count": { "type": "uniform_int", "min": 3, "max": 3 },
  "palette_structure": [
    {
      "role": "grounding_anchor",
      "hue": { "type": "uniform", "min": 0.0, "max": 1.0 },
      "lightness": { "type": "gaussian", "mu": 0.28, "sigma": 0.07, "clip": [0.12, 0.40] },
      "chroma": { "type": "gaussian", "mu": 0.22, "sigma": 0.07, "clip": [0.08, 0.40] }
    },
    {
      "role": "accent_core",
      "hue": { "type": "relative", "target": "grounding_anchor", "mu_offset": 140, "sigma": 45 },
      "lightness": { "type": "gaussian", "mu": 0.65, "sigma": 0.10, "clip": [0.48, 0.85] },
      "chroma": { "type": "gaussian", "mu": 0.38, "sigma": 0.08, "clip": [0.22, 0.58] }
    }
  ],
  "overrides": {
    "engine": "fluid-wave",
    "complexity": 4,
    "noise": 0.025,
    "vignette": 0.12,
    "dots": 0.0,
    "glass": false
  }
}
