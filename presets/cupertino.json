{
  "preset_id": "cupertino",
  "color_space": "oklch",
  "color_count": {
    "type": "uniform_int",
    "min": 2,
    "max": 5
  },
  "palette_structure": [
    {
      "role": "grounding_anchor",
      "hue": { "type": "uniform", "min": 0, "max": 1.0 },
      "lightness": {
        "type": "bimodal",
        "description": "70% chance dark mode, 30% chance light mode",
        "modes": [
          { "weight": 0.7, "type": "gaussian", "mu": 0.18, "sigma": 0.04, "clip": [0.08, 0.28] },
          { "weight": 0.3, "type": "gaussian", "mu": 0.94, "sigma": 0.02, "clip": [0.88, 0.98] }
        ]
      },
      "chroma": { "type": "beta", "alpha": 2, "beta": 8, "scale": 0.10 }
    },
    {
      "role": "accent_core",
      "hue": { "type": "relative", "target": "grounding_anchor", "mu_offset": 0, "sigma": 60 },
      "lightness": { "type": "gaussian", "mu": 0.68, "sigma": 0.07, "clip": [0.52, 0.82] },
      "chroma": { "type": "gaussian", "mu": 0.50, "sigma": 0.12, "clip": [0.28, 0.70] }
    }
  ],
  "overrides": {
    "noise": { "type": "gaussian", "mu": 0.02, "sigma": 0.01, "clip": [0.0, 0.05] },
    "fluid_mode": "spatial"
  }
}
